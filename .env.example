# Discord ボットトークン (必須)
# https://discord.com/developers/applications でボットを作成してトークンを取得してください
DISCORD_TOKEN=your_discord_bot_token_here

# データベースファイルのパス (省略可、デフォルト: tasks.db)
# Docker の場合は docker-compose.yml で /data/tasks.db に固定されます
DATABASE_URL=tasks.db

# 期限を解釈するタイムゾーン (省略可、デフォルト: Asia/Tokyo)
# IANA タイムゾーン名で指定（例: Asia/Tokyo, UTC, America/New_York）
TIMEZONE=Asia/Tokyo

# ギルドID (省略可)
# 設定するとそのサーバーにのみコマンドを登録し即時反映される（開発・テスト用）
# 未設定の場合はグローバル登録（反映まで最大1時間）
#GUILD_ID=123456789012345678
