# Discord ボットトークン (必須)
# https://discord.com/developers/applications でボットを作成してトークンを取得してください
DISCORD_TOKEN=your_discord_bot_token_here

# データベースファイルのパス (省略可、デフォルト: tasks.db)
DATABASE_URL=tasks.db

# 期限を解釈するタイムゾーン (省略可、デフォルト: Asia/Tokyo)
# IANA タイムゾーン名で指定（例: Asia/Tokyo, UTC, America/New_York）
TIMEZONE=Asia/Tokyo

# ギルドID (省略可)
# 設定するとそのサーバーにのみコマンドを登録し即時反映される（開発・テスト用）
# 未設定の場合はグローバル登録（反映まで最大1時間）
#GUILD_ID=123456789012345678

# ── Web ダッシュボード（省略可。3つとも設定すると有効になる）──
# Discord Developer Portal → OAuth2 の Client ID / Client Secret
#DISCORD_CLIENT_ID=123456789012345678
#DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 外からアクセスする URL（OAuth2 の Redirects に「この URL + /auth/callback」を登録する）
#WEB_BASE_URL=https://hw.example.com
# 待ち受けるアドレス（省略時 0.0.0.0:8080）
#WEB_ADDR=0.0.0.0:8080
